                      ({"000150": "문자열"}, "엔트리가 문자열")]:
        try:
            r = rt.ValHist(bad).ttm_position("000150")
            print(f"  OK   {desc:<16s} → {r}")
        except Exception as exc:                                   # noqa: BLE001
            print(f"  FAIL {desc:<16s} {type(exc).__name__}: {exc}")
            fails.append(f"ValHist {desc}: {exc}")

    print("\n" + ("=" * 60))
    if fails:
        print(f"실패 {len(fails)}건")
        for f in fails:
            print(f"  - {f}")
        return 1
    print("전부 통과")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
